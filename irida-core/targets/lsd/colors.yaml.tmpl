# lsd colours for {{ name }}, generated by Irida from the palette. Each
# value is a truecolor [r,g,b] array, which lsd 1.0 reads, so the colours
# match the palette exactly instead of the nearest 256-colour code.
user: [{{ accent|rgb }}]
group: [{{ muted|rgb }}]
permission:
  read: [{{ muted|rgb }}]
  write: [{{ warning|rgb }}]
  exec: [{{ error|rgb }}]
  exec-sticky: [{{ error|rgb }}]
  no-access: [{{ comment|rgb }}]
  octal: [{{ text|rgb }}]
  acl: [{{ text|rgb }}]
  context: [{{ text|rgb }}]
date:
  hour-old: [{{ accent|rgb }}]
  day-old: [{{ success|rgb }}]
  older: [{{ comment|rgb }}]
size:
  none: [{{ comment|rgb }}]
  small: [{{ success|rgb }}]
  medium: [{{ warning|rgb }}]
  large: [{{ error|rgb }}]
inode:
  valid: [{{ success|rgb }}]
  invalid: [{{ error|rgb }}]
links:
  valid: [{{ text|rgb }}]
  invalid: [{{ error|rgb }}]
tree-edge: [{{ comment|rgb }}]
git-status:
  default: [{{ comment|rgb }}]
  unmodified: [{{ comment|rgb }}]
  ignored: [{{ comment|rgb }}]
  new-in-index: [{{ success|rgb }}]
  new-in-workdir: [{{ success|rgb }}]
  typechange: [{{ warning|rgb }}]
  deleted: [{{ error|rgb }}]
  renamed: [{{ text|rgb }}]
  modified: [{{ accent|rgb }}]
  conflicted: [{{ error|rgb }}]

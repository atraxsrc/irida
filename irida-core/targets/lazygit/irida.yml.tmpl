{%- set file = slug ~ ".yml" if export else "irida.yml" -%}
{%- set bg = term.background or pane -%}
# {{ name }} ({{ mode }}) for lazygit, written by Irida. Only the colours:
# your own config.yml keeps the rest. Read next to config.yml through
# LG_CONFIG_FILE, which the {% if export %}zsh/{{ slug }}.zsh layer{% else %}Irida block in ~/.zshrc{% endif %} sets; another shell needs
#   export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/{{ file }}"
gui:
  theme:
    activeBorderColor:
      - "{{ accent }}"
      - bold
    inactiveBorderColor:
      - "{{ mix(container, "text", 0.25) }}"
    searchingActiveBorderColor:
      - "{{ warning }}"
      - bold
    optionsTextColor:
      - "{{ muted }}"
    selectedLineBgColor:
      - "{{ mix(bg, "accent", 0.35) }}"
    inactiveViewSelectedLineBgColor:
      - "{{ mix(bg, "text", 0.10) }}"
    cherryPickedCommitFgColor:
      - "{{ bg }}"
    cherryPickedCommitBgColor:
      - "{{ term.normal.yellow }}"
    markedBaseCommitFgColor:
      - "{{ bg }}"
    markedBaseCommitBgColor:
      - "{{ success }}"
    unstagedChangesColor:
      - "{{ error }}"
    defaultFgColor:
      - "{{ text }}"
  authorColors:
    "*": "{{ term.normal.yellow }}"
